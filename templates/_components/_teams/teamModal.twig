{% import "_macros/utils" as utils %}
{# Team member profile in a slide-in panel (Teams block "Card Click Action" = modal).
   Styled like the desktop sidebar menu (DESIGN.md §6): Parchment panel from the
   right, outlined close button, "Team" eyebrow, contact links pinned to an Aged
   Paper foot. Opened by teamCard.twig with $store.modal.open(modalId); uses the
   shared smoothModal component, so Escape, the overlay and the close button close it.
   Params: team (teamMembers entry), modalId #}
{% import "_macros/images" as images %}
{% set photo = team.image.one() ?? null %}
{% set socialMedia = team.socialMedia.all() %}
{% set hasFoot = team.plainTextPhone|length or team.email|length or socialMedia|length %}
<div x-data="smoothModal('{{ modalId }}')" x-show="$store.modal.active === '{{ modalId }}'" @keydown.escape.window="$store.modal.close()"
	class="team-drawer" id="{{ modalId }}" role="dialog" aria-modal="true" aria-labelledby="{{ modalId }}-name" data-theme="light" style="display: none;">

	<div x-show="$store.modal.active === '{{ modalId }}'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
		class="sidebar-overlay-premium fixed inset-0" @click="$store.modal.close()" aria-hidden="true"></div>

	<div class="team-drawer-panel sidebar-light fixed top-0 right-0 flex flex-col h-[100dvh]"
		x-show="$store.modal.active === '{{ modalId }}'"
		x-transition:enter="transition-transform ease-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
		x-transition:leave="transition-transform ease-in duration-200" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full">

		<div class="team-drawer-top shrink-0">
			<span class="team-drawer-eyebrow">{{ 'Team profile'|t }}</span>
			<button type="button" class="sidebar-close-btn group" @click="$store.modal.close()" aria-label="{{ 'Close'|t }}">
				<i class="ti ti-x text-xl transform group-hover:rotate-90 transition-transform duration-300" aria-hidden="true"></i>
			</button>
		</div>

		<div class="team-drawer-scroll flex-1 overflow-y-auto overscroll-contain" x-ref="scrollWrapper" data-lenis-prevent>
			<div class="team-drawer-body">
				{# Photo beside name and role, hairline under the name block, then bio and quote #}
				<div class="team-drawer-head {{ photo ? 'has-photo' : '' }}">
					{% if photo %}
						<div class="team-drawer-photo">
							{{ images.singleImg(photo, 320, {'ratio': 1}, 'w-full h-full object-cover', { alt: team.title }) }}
						</div>
					{% endif %}
					<div class="team-drawer-id">
						<h2 class="team-drawer-name" id="{{ modalId }}-name">{{ team.title }}</h2>
						{% if team.plainTextRole|length %}
							<p class="team-drawer-role">{{ team.plainTextRole }}</p>
						{% endif %}
						{% if team.plainText|length %}
							<p class="team-drawer-focus">{{ team.plainText }}</p>
						{% endif %}
					</div>
				</div>

				{% if team.description|length %}
					<div class="team-drawer-text tw-rich-text">{{ team.description }}</div>
				{% endif %}

				{% set quote = (team.highlightQuote ?? '')|trim %}
				{% if quote|length %}
					<blockquote class="team-drawer-quote">&ldquo;{{ quote|replace({'“': '', '”': ''})|trim('"') }}&rdquo;</blockquote>
				{% endif %}
			</div>
		</div>

		{% if hasFoot %}
			<div class="sidebar-foot team-drawer-foot shrink-0 flex">
				{% if team.plainTextPhone|length or team.email|length %}
					<div class="flex flex-wrap gap-x-3 gap-y-1">
						{% if team.plainTextPhone|length %}
							<a class="sidebar-contact-link" href="tel:{{ team.plainTextPhone|replace({' ': ''}) }}">
								<span class="sidebar-contact-icon"><i class="ti ti-phone text-lg" aria-hidden="true"></i></span>
								{{ team.plainTextPhone }}
							</a>
						{% endif %}
						{% if team.email|length %}
							<a class="sidebar-contact-link break-all" href="mailto:{{ team.email }}">
								<span class="sidebar-contact-icon"><i class="ti ti-mail text-lg" aria-hidden="true"></i></span>
								{{ team.email }}
							</a>
						{% endif %}
					</div>
				{% endif %}
				{% if socialMedia|length %}
					<div class="flex gap-2">
						{% for social in socialMedia %}
							<a href="{{ social.linkUrl }}" class="social-dot" {{ utils.newTabAttrs(social.linkUrl) }}
							   aria-label="{{ utils.linkPlatform(social.linkUrl) }} profile for {{ team.title }}">
								{% if social.iconClass|length %}
									<i class="{{ social.iconClass|icon }}" aria-hidden="true"></i>
								{% elseif social.iconImage|length %}
									{{ images.singleImg(social.iconImage.one(), 24, {}, 'w-4 h-4') }}
								{% endif %}
							</a>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		{% endif %}
	</div>
</div>
