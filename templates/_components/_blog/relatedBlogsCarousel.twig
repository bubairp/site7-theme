{% import "_macros/utils" as utils %}
{% if generalEntry.relatedBlogs | length %}
	{# Same-category posts first, then the latest others, so every post has related reading #}
	{% set post = blog ?? entry %}
	{% set postCategories = post.blogCategories.ids() %}
	{% set relatedBlogs = postCategories|length
		? craft.entries().section('blogs').relatedTo({ targetElement: postCategories, field: 'blogCategories' }).id('not ' ~ post.id).with(['image', 'blogCategories', 'tags']).orderBy('postDate DESC').limit(6).all()
		: [] %}
	{% if relatedBlogs|length < 3 %}
		{% set relatedBlogs = relatedBlogs|merge(craft.entries().section('blogs').id(['and', 'not ' ~ post.id]|merge(relatedBlogs|map(b => 'not ' ~ b.id))).with(['image', 'blogCategories', 'tags']).orderBy('postDate DESC').limit(3 - relatedBlogs|length).all()) %}
	{% endif %}
	{% if relatedBlogs | length %}
		<div class="section-head is-left related-head">
			<span class="section-eyebrow">{{ 'Keep reading'|t }}</span>
			<h2 class="block-heading-title section-title w-full text-{{ generalEntry.blogTextAlign.value|replace({'start': 'left', 'end': 'right'}) }}" style="color: {{ (generalEntry.blogTitleColor.one().colorcode ?? '')|roleColor }}">{{ 'More from the journal'|t }}</h2>
		</div>

		<div class="swiper" data-swiper-options='{{ utils.swiperConfig(generalEntry.blogColumnPerRow.value, 24, true, true) }}'>
			<div class="swiper-wrapper">
				{% for blog in relatedBlogs %}
					{% include "_components/_blog/singleBlogInSlider.twig" with { blog: blog } %}
				{% endfor %}
			</div>
			<div class="swiper-pagination relative bottom-0 mt-4 pt-2"></div>
		</div>
	{% endif %}
{% endif %}
