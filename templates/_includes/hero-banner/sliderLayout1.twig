{# Hero layout 1 (split, DESIGN.md §8): the copy on a band, the media in a large rounded
   frame beside it. Band: the slide's colour, else Parchment, or Ink when the slide's
   "Theme dark" is on (light text). Fills the screen below the header. Below 1024px the
   media moves behind the copy (see sections.css). #}
{% set multi = heroBannerSliders|length > 1 %}
{% set firstDark = (heroBannerSliders|first).themeDark ?? false %}
<section class="hero-split hero-layout {{ firstDark ? 'is-dark' : 'is-light' }} relative w-full">
	<div class="{{ multi ? 'swiper' : '' }}" {% if multi %}data-swiper-options='{"effect": "fade","fadeEffect": {"crossFade": true},"speed": 800,"autoplay": {"delay": 7000,"disableOnInteraction": false},"pagination": {"el": ".swiper-pagination","clickable": true}}'{% endif %}>
		<div class="{{ multi ? 'swiper-wrapper' : '' }}">
			{% for slide in heroBannerSliders %}
				{% set dark = slide.themeDark ?? false %}
				{% set bgColor = (slide.colorLibrary.one().colorcode ?? null)|roleColor %}
				{% set hasMedia = slide.imageVideo|length or slide.bgImageVideoMobile|length %}
				<div class="{{ multi ? 'swiper-slide' : '' }} hero-split-slide {{ dark ? 'is-dark' : 'is-light' }} {{ hasMedia ? 'has-media' : '' }}" data-theme="{{ dark ? 'dark' : 'light' }}" {% if bgColor %}style="background-color: {{ bgColor }};"{% endif %}>
					<div class="container mx-auto px-4">
						<div class="hero-split-grid">
							<div class="hero-split-copy">
								{% include "_includes/hero-banner/_copy" with { headingTag: loop.first ? 'h1' : 'h2', eyebrowClass: 'section-eyebrow' } %}
							</div>
							{% if hasMedia %}
								<div class="hero-split-media">
									{% include "_includes/hero-banner/_media-pair" with { width: 1200, eager: loop.first } %}
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
		{% if multi %}<div class="swiper-pagination swiper-pagination-overlay hero-pagination"></div>{% endif %}
	</div>
</section>
