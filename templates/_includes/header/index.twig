{% import "_macros/images" as images %}
{% set headerLayout = headerEntry.headerLayout %}
{% set headerButton = headerEntry.button ?? null %}
{% set headerContainerWidth = headerEntry.containerWidth.value ?? null %}

{% set headerVerticalAlign = headerEntry.verticalAlign %}
{% set headerDisplaySearch = headerEntry.displaySearch %}
{% set headerDisplaySocial = headerEntry.displaySocial %}
{% set headerDisplayCTA = headerEntry.displayCTA %}
{% set headerDisplayPhone = headerEntry.displayPhone %}
{% set headerDisplayEmail = headerEntry.displayEmail %}
{# {% set headerDisplayAddress = headerEntry.displayAddress %} #}
{% set headerDisplayThinbar = headerEntry.displayThinbar %}
{% set headerBackground = headerEntry.background.one() ?? null %}
{% set headerSpacingData = headerEntry.spacing.one() ?? null %}
{% set headerClasses = headerEntry.headerClasses %}
{# Header > Style > "Header over banner": Floating glass turns the bar into a frosted
   pill over the page's hero/banner until the page scrolls (components/header.css) #}
{% if (headerEntry.headerOverBanner.value ?? '') == 'floatingGlass' %}
	{% set headerClasses = (headerClasses ~ ' header-floating-glass')|trim %}
{% endif %}
{% set headerPositioning = headerEntry.positioning.value ?? null %}
{% set headerBackgroundColor = headerBackground.colorLibrary.one().colorcode.getRgb() ?? null %}
{% set headerBackgroundImage = headerBackground.image.one() ? images.bgImageUrl(headerBackground.image.one())|trim : null %}

{% set themeSwitche = headerEntry.background.one().themeDark ?? null  %}

{% if headerSpacingData.mediaScreen is defined %}
	{% set mediaScreen = headerSpacingData.mediaScreen ?? null %}
{% endif %}
{% set padding = headerSpacingData.padding ?? null %}
{% set topPadding = padding[0].top ?? null %}
{% set rightPadding = padding[0].right ?? null %}
{% set bottomPadding = padding[0].bottom ?? null %}
{% set leftPadding = padding[0].left ?? null %}

{% set margin = headerSpacingData.margin ?? null %}
{% set topMargin = margin[0].top ?? null %}
{% set rightMargin = margin[0].right ?? null %}
{% set bottomMargin = margin[0].bottom ?? null %}
{% set leftMargin = margin[0].left ?? null %}

{% set paddingTab = headerSpacingData.paddingTab ?? null %}
{% set topPaddingTab = paddingTab[0].top ?? null %}
{% set rightPaddingTab = paddingTab[0].right ?? null %}
{% set bottomPaddingTab = paddingTab[0].bottom ?? null %}
{% set leftPaddingTab = paddingTab[0].left ?? null %}

{% set marginTab = headerSpacingData.marginTab ?? null %}
{% set topMarginTab = marginTab[0].top ?? null %}
{% set rightMarginTab = marginTab[0].right ?? null %}
{% set bottomMarginTab = marginTab[0].bottom ?? null %}
{% set leftMarginTab = marginTab[0].left ?? null %}

{% set paddingMob = headerSpacingData.paddingMob ?? null %}
{% set topPaddingMob = paddingMob[0].top ?? null %}
{% set rightPaddingMob = paddingMob[0].right ?? null %}
{% set bottomPaddingMob = paddingMob[0].bottom ?? null %}
{% set leftPaddingMob = paddingMob[0].left ?? null %}

{% set marginMob = headerSpacingData.marginMob ?? null %}
{% set topMarginMob = marginMob[0].top ?? null %}
{% set rightMarginMob = marginMob[0].right ?? null %}
{% set bottomMarginMob = marginMob[0].bottom ?? null %}
{% set leftMarginMob = marginMob[0].left ?? null %}

{% import "_macros/layout" as layout %}

{# Handle container width #}
{% if headerEntry.containerWidth is defined and headerEntry.containerWidth.value is not empty %}
	{% set headerContainerWidth = layout.getContainerClass(headerEntry.containerWidth.value) %}
{% else %}
	{% set headerContainerWidth = 'container mx-auto px-4' %}
{% endif %}

{# Handle container position #}
{% if headerEntry.positioning is defined and headerEntry.positioning.value is not empty %}
	{% set containerPositioningMap = {
		'static': 'static',
		'fixed': 'fixed top-0 right-0 left-0 z-1030',
		'sticky': 'sticky top-0 z-1030',
	} %}
	{% set headerPositioning = containerPositioningMap[headerEntry.positioning.value] ?? 'static' %}
{% else %}
	{% set headerPositioning = 'static' %}
{% endif %}

{# The layout picked in the CMS, falling back to simpleHeader when it's empty or
   its template doesn't exist. Use .value: the dropdown object is truthy even when
   empty, and '_includes/header/' alone resolves to this index file (infinite loop). #}
{% set headerLayoutHandle = (headerEntry.headerLayout.value ?? '')|default('simpleHeader') %}
{% include [
	'_includes/header/' ~ headerLayoutHandle,
	'_includes/header/simpleHeader'
] %}
{# The header is position:absolute and the .header-height spacer reserves its
   height via --header-height. Measure it before first paint so content doesn't
   jump from the 100px fallback; app.js keeps it updated on resize.
   --header-bar-height is the logo row only (.header-main, no notification bar);
   the sidebar's top row uses it so the two line up. #}
<script>(function(){var r=document.documentElement.style,h=document.querySelector('.headerMain');if(!h)return;var s=h.querySelector('.search-field'),b=h.querySelector('.header-main');r.setProperty('--header-height',(h.offsetHeight-(s?s.offsetHeight:0))+'px');if(b)r.setProperty('--header-bar-height',b.offsetHeight+'px');})();</script>


{% import "_macros/spacing" as spacingHelper %}
{{ spacingHelper.boxSpacingStyle('.header-main', headerSpacingData, headerBackgroundColor, headerBackgroundImage) }}
