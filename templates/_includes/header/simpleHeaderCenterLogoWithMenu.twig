{% import "_macros/images" as images %}
{% import '_components/ctaButton' as buttons %}

<!-- Navbar. Wrapper scope holds the mobile sidebar state (sidebarOpen). -->
<div x-data="sidebarMenu">
<div class="headerMain {{ headerClasses }} {{ headerPositioning }} sticky w-full z-[1030] bg-white/95 dark:bg-dark/95 backdrop-blur-xl transition-all duration-300" {% if themeSwitche %} data-theme="dark" {% else %} data-theme="light" {% endif %}>
	{% if headerDisplayThinbar %}
		<div class="header-top bg-accent py-1 text-on-dark">
			<div class="container text-center text-sm">{{ generalEntry.headerNotification }}</div>
		</div>
	{% endif %}
	<div class="header-main tw-navbar flex flex-wrap bg-light py-2">
		{# .header-panel is the header's container (Header > Container Width). It holds the bar
		   row and, where there is one, the search field, so the Floating glass option can
		   style them as one box (components/header.css). Unstyled for "Solid bar". #}
		<div class="header-panel {{ headerContainerWidth }}">
			<div class="flex flex-wrap lg:flex-nowrap items-center justify-between w-full">
				<div class="hidden lg:flex items-center w-1/2 justify-evenly">
					<div class="main-menu h-full hidden lg:block">
						<nav class="tw-navbar h-full py-0">
							<div
								class="h-full" id="navbarNav1">
								<!-- Navbar collapse (Main navigation) -->
								{{ craft.simplerpmenu.getRpMenuHTML('headerMenuLeft',{ 
									'menu-id': 'headerMenuLeft',
									'menu-class':'simple-rp-menu headerMenuLeft me-auto',
									'ul-class':'menu-ul flex flex-col lg:flex-row p-0 m-0',
									'li-class':'',
									'sub-menu-ul-class':'sub-menu-ul',
									'link-class':'nav-link', }) 
								}}</div>
						</nav>
					</div>
				</div>
				{% if generalEntry.logo|length %}
					<div class="logo shrink-0">
						<a href="/" class="navbar-brand">
							<span class="text-white shrink-0">
								{% include "_includes/header/_parts/logo" %}
							</span>
						</a>
					</div>
				{% endif %}
				<div class="hidden lg:flex items-center w-1/2 justify-evenly">
					<div class="main-menu h-full hidden lg:block">
						<nav class="mega-header tw-navbar h-full py-0">
							<div class="h-full" id="navbarNav2">{{ craft.simplerpmenu.getRpMenuHTML('headerMenuRight',{ 
									'menu-id': 'headerMenuRight',
									'menu-class':'simple-rp-menu headerMenuRight ms-auto',
									'ul-class':'menu-ul flex flex-col lg:flex-row p-0 m-0',
									'li-class':'',
									'sub-menu-ul-class':'sub-menu-ul',
									'link-class':'nav-link', }) 
								}}</div>
						</nav>
					</div>
				</div>

				<!-- Mobile menu toggler (Hamburger) — opens the sidebar below lg -->
				<button id="sidebarMenuToggle" @click="sidebarOpen = true" :aria-expanded="sidebarOpen ? 'true' : 'false'" class="inline-flex items-center justify-center w-10 h-10 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors border-none bg-transparent lg:hidden ms-2 lg:order-3 cursor-pointer p-0" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="offcanvasRight">
					<span class="hamburger-icon" aria-hidden="true">
						<span class="bar bar-1"></span>
						<span class="bar bar-2"></span>
						<span class="bar bar-3"></span>
					</span>
				</button>
			</div>
		</div>
	</div>
</div>
{# Mobile sidebar (left + right menus): OUTSIDE headerMain so its fixed position isn't trapped by backdrop-blur #}
{% include '_includes/header/_parts/sidebar' with { variant: 'light', menus: ['headerMenuLeft', 'headerMenuRight'] } %}
</div>
<div class="header-height" style="min-height: var(--header-height, 100px);"></div>
