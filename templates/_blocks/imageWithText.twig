{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}
{% import '_components/ctaButton' as buttons %}
{% set headingAndContent = block.headingAndContent.one() %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}

{% set containerWidth = 'container' %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.getFieldLayout().getFieldByHandle('contentdata') ? block.contentdata : '' %}

{% set titleTags = block.titleTags ?? 'h2' %}

{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
{% set themeSwitche = null %}
{% set isImageBorderRadius = block.imageBorderRounded ?? false %}

{% if block %}
	{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% if blockStyleData.background is defined %}
			{% set backgroundEntry = blockStyleData.background.one() %}
			{% set themeSwitche = backgroundEntry.themeDark ?? null %}
		{% endif %}
	{% endif %}

	{% set isColumnReverse = block.sideSwitch ?? false %}

	{# Media: "Image or video" (imageVideo: an image, a video file or an embedded video). A
	   block saved before it had imageContent (the image-only Image field): while that field
	   is still in the layout it's read by name; once the block package removes it, its image
	   is still related to the block through the Image field, so it's found there. A site whose
	   block predates imageVideo/aspectRatio/button renders too: each is read only when its
	   field is in the layout (asked of the layout: "is defined" can't tell, an entry answers
	   any name). #}
	{% set layout = block.getFieldLayout() %}
	{% set media = layout.getFieldByHandle('imageVideo') ? block.imageVideo.one() : null %}
	{% if not media %}
		{% set media = layout.getFieldByHandle('imageContent')
			? block.imageContent.one()
			: craft.assets().relatedTo({ sourceElement: block, field: 'image' }).one() %}
	{% endif %}
	{% set mediaKind = not media ? null : (media.kind == 'json' ? 'embed' : (media.kind == 'video' ? 'video' : 'image')) %}
	{# Shape: Default is the block's own (4 / 3.4; an embedded video 16:9) #}
	{% set shape = layout.getFieldByHandle('aspectRatio') ? (block.aspectRatio.value ?? 'default') : 'default' %}
	{% set shapeRatio = {'square': '1 / 1', 'fourThree': '4 / 3', 'sixteenNine': '16 / 9'}[shape] ?? (mediaKind == 'embed' ? '16 / 9' : null) %}
	{% set imageRatio = {'square': 1, 'fourThree': 4 / 3, 'sixteenNine': 16 / 9}[shape] ?? null %}

	{{ bsResponsive(blockStyle, scopedSel) }}
	<section class="block-section split-section {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% if headingAndContent.heading|length or headingAndContent.Description|length %}
					{% include "_components/header-content-block" %}
				{% endif %}
			{% endif %}

			<div class="split-grid {{ isColumnReverse ? 'is-reversed' : '' }}">
				<div class="split-media {{ isColumnReverse ? 'lg:order-2' : '' }}">
					{% if media %}
						<div class="split-frame is-{{ mediaKind }} {{ isImageBorderRadius ? 'is-rounded' : 'is-square' }}" {% if shapeRatio %}style="--split-ratio: {{ shapeRatio }};"{% endif %}>
							{% if mediaKind == 'image' %}
								{{ images.singleImg(media, 1000, imageRatio ? {'ratio': imageRatio} : {}, 'split-image w-full ' ~ (isImageBorderRadius ? 'is-rounded' : 'is-square'), {}) }}
							{% elseif mediaKind == 'video' %}
								{# A video file plays like the banners: muted, looped, inline, no controls #}
								<video class="split-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
									<source src="{{ media.url }}" type="{{ media.mimeType }}">
								</video>
							{% else %}
								{% set embedded = craft.embeddedAssets.get(media) %}
								{% if embedded %}
									{{ embedded.getIframeCode(['autoplay=0', 'loop=0', 'background=0', 'class=split-embed'])|raw }}
								{% endif %}
							{% endif %}
						</div>
					{% endif %}
				</div>

				<div class="split-copy {{ isColumnReverse ? 'lg:order-1' : '' }}">
					<div class="flex flex-col justify-center {{ align == 'center' ? 'items-center text-center' : (align == 'right' ? 'items-end text-right' : 'items-start text-left') }}">
						{% if block.title %}
							<{{titleTags}} class="block-heading-title split-title w-full">{{ block.title|e|replace({'{': '<em>', '}': '</em>'})|raw }}</{{titleTags}}>
						{% endif %}

						<div class="block-description split-text tw-rich-text w-full">{{ block.textContent }}</div>

						{% set imageTextBtn = layout.getFieldByHandle('button') ? block.button : null %}
						{% if imageTextBtn|length %}
							<div class="flex flex-wrap items-center gap-4 pt-2 lg:pt-4">{{ buttons.renderButton(imageTextBtn) }}</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</section>
{% endif %}
