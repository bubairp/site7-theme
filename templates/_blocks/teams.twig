{% import "_macros/utils" as utils %}
{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}
{% set headingAndContent = block.headingAndContent.one() %}
{# Selected members in the chosen order; with none selected, every live team member #}
{% set selectedTeams = block.selectTeamMembers is defined ? block.selectTeamMembers.with(['image', 'socialMedia']).all() : [] %}
{% set selectTeams = selectedTeams|length ? selectedTeams : craft.entries().section('teamMembers').with(['image', 'socialMedia']).all() %}
{# Card click: detailPage (default) / modal / none #}
{% set clickAction = block.teamClickAction.value ?? 'detailPage' %}
{% set clickAction = clickAction in ['modal', 'none'] ? clickAction : 'detailPage' %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{% set containerWidth = 'container' %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.getFieldLayout().getFieldByHandle('contentdata') ? block.contentdata : '' %}

{% set blockCssClasses = '' %}
{% set themeSwitche = '' %}

{% if not selectTeams %}{% include '_components/empty-block-notice' with { what: 'team members'|t, pack: 'Team Pack'|t } only %}{% endif %}
{% if selectTeams %}
	{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
	{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
	{% set themeSwitche = null %}

	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% if blockStyleData.background is defined %}
			{% set backgroundEntry = blockStyleData.background.one() %}
			{% set themeSwitche = backgroundEntry.themeDark ?? null %}
		{% endif %}
	{% endif %}

	{{ bsResponsive(blockStyle, scopedSel) }}
	<section class="block-section team-section {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% if headingAndContent.heading|length or headingAndContent.Description|length %}
					{% include "_components/header-content-block" %}
				{% endif %}
			{% endif %}


			{% set displayView = block.displayView.value ?? '' %}{% set displayView = displayView == 'sliderView' ? 'sliderView' : 'gridView' %}{% set perRow = block.teamMemberPerRow.value ?? '3' %}
			{% if displayView == 'gridView' %}
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8 {{ {'2': '', '4': 'lg:grid-cols-4'}[perRow] ?? 'lg:grid-cols-3' }}">
					{% for team in selectTeams %}
						<div>
							{% include "_components/_teams/teamCard.twig" with { team: team, clickAction: clickAction, modalId: 'team-modal-' ~ blockTypeUid ~ '-' ~ team.id } %}
						</div>
					{% endfor %}
				</div>

			{% endif %}

			{% if displayView == 'sliderView' %}
				<div class="swiper" data-swiper-options='{{ utils.swiperConfig(perRow, 24) }}'>
					<div class="swiper-wrapper pb-4">
						{% for team in selectTeams %}
							<div class="swiper-slide h-auto">
								{% include "_components/_teams/teamCard.twig" with { team: team, clickAction: clickAction, modalId: 'team-modal-' ~ blockTypeUid ~ '-' ~ team.id } %}
							</div>
						{% endfor %}
					</div>
					<!-- Pagination (bullets) -->
					<div class="swiper-pagination relative bottom-0 mt-2 pt-4"></div>
				</div>
			{% endif %}
		</div>

		{# Profile modals sit outside the grid/slider so slide transforms can't clip them #}
		{% if clickAction == 'modal' %}
			{% for team in selectTeams %}
				{% include "_components/_teams/teamModal.twig" with { team: team, modalId: 'team-modal-' ~ blockTypeUid ~ '-' ~ team.id } %}
			{% endfor %}
		{% endif %}
	</section>

{% endif %}
