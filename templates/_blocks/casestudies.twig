{% import "_macros/utils" as utils %}
{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}
{% set headingAndContent = block.headingAndContent.one() %}
{# Nothing selected means "all case studies", as in the blogs and portfolios blocks #}
{% set relationQuery = block['selectCasestudies'] ?? null %}
{% if relationQuery and relationQuery.count() %}
	{% set selectCasestudies = relationQuery.with(['image', 'tags']) %}
{% else %}
	{% set selectCasestudies = craft.entries.section('casestudies').with(['image', 'tags']) %}
{% endif %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
{% set themeSwitche = null %}

{% if blockStyle is defined and blockStyle|length %}
	{% set blockStyleData = blockStyle.one() %}
	{% if blockStyleData.background is defined %}
		{% set backgroundEntry = blockStyleData.background.one() %}
		{% set themeSwitche = backgroundEntry.themeDark ?? null %}
	{% endif %}
{% endif %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.getFieldLayout().getFieldByHandle('contentdata') ? block.contentdata : '' %}
{% set paginationData = block.paginations.one() ?? '' %}

{# Something to list: the selected entries, or any in the section (docs/43 #55). A query object is
   always true, so checking it alone rendered an empty section on sites without the Case Studies Pack. #}
{% set hasEntries = (relationQuery and relationQuery.count()) or craft.entries.section('casestudies').exists() %}
{% if not hasEntries %}{% include '_components/empty-block-notice' with { what: 'case studies'|t, pack: 'Case Studies Pack'|t } only %}{% endif %}
{% if hasEntries %}
	{% block structured_data %}
		{% if entry is defined
				and entry.type is defined
				and entry.type.handle == 'standardPages'
				and (craft.app.request.getParam('partial') is empty)
		%}

			{% set posts = (selectCasestudies is defined and selectCasestudies|length) ? selectCasestudies|slice(0, 2) : [] %}

			{% set listItems = [] %}
			{% for p in posts %}
				{% set listItems = listItems|merge([{
				"@type": "ListItem",
				"position": loop.index,
				"item": { "@id": p.url ~ "#post", "url": p.url }
			}]) %}
			{% endfor %}

			{% set webPage = {
			"@type": ["WebPage","CollectionPage"],
			"@id": entry.url ~ "#webpage",
			"url": entry.url,
			"name": entry.title,
			"mainEntity": { "@id": entry.url ~ "#list" },
			"breadcrumb": { "@id": entry.url ~ "#breadcrumb" }
			} %}

			{% set itemList = {
			"@type": "ItemList",
			"@id": entry.url ~ "#list",
			"name": "Case study posts",
			"numberOfItems": posts|length,
			"itemListElement": listItems
			} %}

			{% set breadcrumb = {
			"@type": "BreadcrumbList",
			"@id": entry.url ~ "#breadcrumb",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl() },
				{ "@type": "ListItem", "position": 2, "name": entry.title, "item": entry.url }
			]
			} %}

			<script type="application/ld+json">
				{{ {
				"@context": "https://schema.org",
				"@graph": [ webPage, itemList, breadcrumb ]
			}|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
			</script>
		{% endif %}
	{% endblock %}

	{{ bsResponsive(blockStyle, scopedSel) }}

	<section class="block-section work-section {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% include "_components/header-content-block" %}
			{% endif %}

			{# Default renders as the grid. List: image-beside-text rows between hairlines.
			   Masonry: the grid laid out by masonry-grid.js (cards keep their natural height). #}
			{% set displayView = block.displayView.value ?? '' %}
			{% set layout = displayView in ['listView', 'masonryView'] ? displayView : 'gridView' %}
			{% set displayView = displayView == 'sliderView' ? 'sliderView' : 'gridView' %}
			{% set perRow = block.caseStudyPerRow.value ?? '3' %}
			{% set cardVariant = layout == 'listView' ? 'row' : 'card' %}
			{% set colsClass = {'2': '', '4': 'lg:grid-cols-4'}[perRow] ?? 'lg:grid-cols-3' %}
			{% set listClass = {
				listView: 'work-list',
				masonryView: 'work-masonry masonry-grid',
				gridView: 'grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8 ' ~ colsClass,
			}[layout] %}

			{% if displayView == 'gridView' %}
				{% set showNav = paginationData.displayPagination ?? false %}
				{% if showNav %}
					{% set perPage = (paginationData.records_per_page ?? 10) %}
					{% set navStyle = paginationData.paginationDisplayStyle ?? 'pagination' %}
					{% set query = selectCasestudies.limit(perPage) %}
					{% paginate query as pageInfo, pageEntries %}
					{% set entries = pageEntries %}
				{% else %}
					{% set entries = selectCasestudies %}
				{% endif %}

				{# Load-more requests only need the next chunk of cards #}
				{% if showNav and craft.app.request.getParam('partial') %}
					<div class="js-chunk" data-next-url="{{ pageInfo.nextUrl ?? '' }}">
						{% for casestudy in pageEntries %}
							{% include "_components/_casestudies/caseStudyCard" with { casestudy: casestudy, itemClass: 'shuffle-item', variant: cardVariant, masonry: layout == 'masonryView' } %}
						{% endfor %}
					</div>
					{% exit %}
				{% endif %}

				<div class="{{ listClass }}" id="js-list"{% if layout == 'masonryView' %} data-columns="{{ perRow }}"{% endif %}>
					{% for casestudy in entries %}
						{% include "_components/_casestudies/caseStudyCard" with { casestudy: casestudy, variant: cardVariant, masonry: layout == 'masonryView' } %}
					{% endfor %}
				</div>
				{% if showNav %}
					{% if navStyle == 'loadMore' %}
						{% include "_components/loadMore" with { pageInfo: pageInfo, targetId: 'js-list', partialQueryString: 'partial=1' } only %}
					{% else %}
						{% include "_components/pagination" with { pageInfo: pageInfo } only %}
					{% endif %}
				{% endif %}
			{% else %}
				<div class="swiper" data-swiper-options='{{ utils.swiperConfig(perRow, 24, true) }}'>
					<div class="swiper-wrapper">
						{% for casestudy in selectCasestudies %}
							{% include "_components/_casestudies/singleCaseStudyInSlider.twig" with { caseStudy: casestudy } %}
						{% endfor %}
					</div>
					<div class="swiper-pagination relative bottom-0 mt-2 pt-4"></div>
				</div>
			{% endif %}
		</div>
	</section>
{% endif %}
