{% extends "_layouts/entry" %}

{% block structured_data %}
	{% if blog %}
		{% set feature = blog.image|length ? blog.image.one() : null %}
		{% set byline = (blog.postAuthor ?? null) ? blog.postAuthor.one() : null %}
		{% set logo    = generalEntry.logo|length ? generalEntry.logo.one() : null %}

		{% set data = {
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": blog.url
		},
		"headline": blog.title,
		"datePublished": blog.postDate|date('c'),
		"dateModified": (blog.dateUpdated is defined and blog.dateUpdated ? blog.dateUpdated|date('c') : blog.postDate|date('c')),
		"author": {
			"@type": "Person",
			"name": byline ? byline.title : (generalEntry.companyName ?? 'Admin')
		}|merge(byline ? { "url": byline.url } : {}),
		"publisher": {
			"@type": "Organization",
			"name": generalEntry.companyName ?? 'Site Name'
		}
		} %}

		{% if feature %}
			{% set data = data|merge({
			"image": [ feature.url ]
		}) %}
		{% endif %}

		{% if logo %}
			{% set publisher = data.publisher|merge({
					"logo": {
					"@type": "ImageObject",
					"url": logo.url
					}
				}) %}
			{% set data = data|merge({ "publisher": publisher }) %}
		{% endif %}
		<script type="application/ld+json">
			{{ data|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
		</script>
	{% endif %}
{% endblock %}

{% set blog = craft.entries()
    .section('blogs')
    .slug(craft.app.request.segment(2))
    .one() %}

{% block content %}
	{# Markup: _layouts/detail/blog.twig (a design overrides that file, not this one) #}
	{% include "_layouts/detail/blog" with { element: blog } %}
{% endblock %}
