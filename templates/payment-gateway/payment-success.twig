{% extends "_layouts/entry" %}

{# Payment result (payment-gateway plugin, PaymentController::actionSuccess): success, gateway,
   orderId, or success false with a message. The layout needs an entry; these aren't CMS pages,
   so there's no breadcrumb. #}
{% set entry = entry ?? craft.entries.section('general').one() %}
{% set success = success ?? false %}
{% set gateway = gateway ?? null %}
{% set orderId = orderId ?? null %}
{% set isFree = gateway in ['Free Plan', 'free'] %}

{% block before_content %}{% endblock %}

{% block content %}
	<section class="block-section payment-result">
		<div class="container mx-auto px-4">
			<div class="tw-card mx-auto max-w-xl p-8 text-center md:p-12">
				{% if success %}
					<div class="mx-auto mb-6 grid size-16 place-items-center rounded-full bg-success/10 text-success" aria-hidden="true">
						<i class="ti ti-check text-3xl"></i>
					</div>
					<p class="section-eyebrow mx-auto w-fit">{{ isFree ? 'Plan'|t : 'Payment'|t }}</p>
					<h1 class="mb-3 text-[clamp(2rem,4vw,2.75rem)] leading-tight">{{ isFree ? 'Plan activated'|t : 'Payment successful'|t }}</h1>
					<p class="mx-auto mb-8 max-w-md text-lg text-body">
						{{ isFree ? 'Your free plan is active. Welcome aboard!'|t : 'Thank you for your purchase. Your plan is now active, and a receipt is on its way to your email.'|t }}
					</p>

					<dl class="mb-8 divide-y divide-line rounded-[var(--radius-base)] border border-line bg-surface text-left text-sm">
						{% if isFree %}
							<div class="flex items-center justify-between gap-4 px-4 py-3">
								<dt class="text-muted">{{ 'Plan'|t }}</dt>
								<dd class="m-0 font-medium text-strong">{{ 'Free'|t }}</dd>
							</div>
						{% else %}
							<div class="flex items-center justify-between gap-4 px-4 py-3">
								<dt class="text-muted">{{ 'Payment method'|t }}</dt>
								<dd class="m-0 font-medium text-strong">{{ gateway|capitalize }}</dd>
							</div>
							<div class="flex items-center justify-between gap-4 px-4 py-3">
								<dt class="shrink-0 text-muted">{{ 'Transaction ID'|t }}</dt>
								<dd class="m-0 min-w-0 break-all text-right font-mono text-xs text-strong">{{ orderId }}</dd>
							</div>
						{% endif %}
					</dl>

					<div class="flex flex-wrap justify-center gap-3">
						<a href="{{ siteUrl }}" class="tw-btn tw-btn-primary no-underline">{{ 'Back to home'|t }}</a>
					</div>
				{% else %}
					<div class="mx-auto mb-6 grid size-16 place-items-center rounded-full bg-danger/10 text-danger" aria-hidden="true">
						<i class="ti ti-x text-3xl"></i>
					</div>
					<p class="section-eyebrow mx-auto w-fit">{{ 'Payment'|t }}</p>
					<h1 class="mb-3 text-[clamp(2rem,4vw,2.75rem)] leading-tight">{{ 'We couldn’t confirm your payment'|t }}</h1>
					<p class="mx-auto mb-8 max-w-md text-lg text-body">{{ message ?? 'We could not verify your payment. If you were charged, contact us with your reference and we will sort it out.'|t }}</p>

					{% if orderId %}
						<dl class="mb-8 divide-y divide-line rounded-[var(--radius-base)] border border-line bg-surface text-left text-sm">
							<div class="flex items-center justify-between gap-4 px-4 py-3">
								<dt class="shrink-0 text-muted">{{ 'Reference'|t }}</dt>
								<dd class="m-0 min-w-0 break-all text-right font-mono text-xs text-strong">{{ orderId }}</dd>
							</div>
						</dl>
					{% endif %}

					<div class="flex flex-wrap justify-center gap-3">
						<a href="{{ url('price') }}" class="tw-btn tw-btn-primary no-underline">{{ 'Try again'|t }}</a>
						<a href="{{ siteUrl }}" class="tw-btn tw-btn-secondary no-underline">{{ 'Back to home'|t }}</a>
					</div>
				{% endif %}
				<p class="mt-8 mb-0 text-sm text-muted">{{ 'Questions about your order?'|t }} <a href="{{ url('contact') }}" class="text-accent">{{ 'Contact us'|t }}</a></p>
			</div>
		</div>
	</section>
{% endblock %}
